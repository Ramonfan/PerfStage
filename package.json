{
  "name": "perfstage-mcp",
  "version": "0.1.0",
  "description": "PerfStage — iOS performance testing platform. Define once, perform every time.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node dist/cli/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "4.1.12"
  },
  "bin": {
    "perfstage": "dist/cli/bin.js"
  }
}
