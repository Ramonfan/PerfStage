  "cards": [
    {
      "dot": "cyan",
      "title": "平台保持通用",
      "items": [
        "PerfStage 只提供场景、执行、证据、报告等通用能力",
        "项目差异收敛到 Scene Skill 和 Scene YAML",
        "新增 App 或场景不需要修改平台内核"
      ]
    },
    {
      "dot": "emerald",
      "title": "执行链路内建",
      "items": [
        "DeviceDriver 用 mobilecli / devicectl 驱动真机",
        "Recorder 直接调用 xctrace 完成三 pass 录制",
        "trace 由 PerfStage 自己解析，不再依赖外部 instruments MCP"
      ]
    },
    {
      "dot": "amber",
      "title": "证据与判定分离",
      "items": [
        "每次 Take 写入独立运行目录，证据可追溯",
        "status 表示测试是否可信，gate 表示是否达标",
        "证据缺失降级为 partial，指标超阈值才是 gate=fail"
      ]
    }
