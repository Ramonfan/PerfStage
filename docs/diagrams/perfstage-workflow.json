{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "PerfStage 测试流程：执行一次 Scene Skill",
    "locale": "zh-CN",
    "output": "perfstage-workflow.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "first-take",
        "label": "首次定义与执行",
        "focus": [
          "scene_yaml",
          "scene_skill",
          "run_tool",
          "runner",
          "device_driver",
          "recorder",
          "report_gate"
        ],
        "note": "项目定义 Scene，执行 Skill 即完成一次完整测试。"
      },
      {
        "id": "evidence-loop",
        "label": "证据与报告",
        "focus": [
          "runstore",
          "report_gate",
          "run_tool"
        ],
        "note": "证据不完整时报告降级为 partial，绝不输出假通过。"
      },
      {
        "id": "encore",
        "label": "返场与回归",
        "focus": [
          "report_gate",
          "run_tool",
          "runstore"
        ],
        "note": "重复执行同一 Skill，对比历史结果并判定回归。"
      }
    ]
  },
  "lanes": [
    {
      "id": "project",
      "label": "项目层（Scene Skill）"
    },
    {
      "id": "platform",
      "label": "PerfStage 内建执行层"
    },
    {
      "id": "evidence",
      "label": "证据 · 报告 · 返场"
    }
  ],
  "phases": [
    {
      "id": "define",
      "label": "定义场景",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "perform",
      "label": "执行一次 Take",
      "fromCol": 2,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "scene_yaml",
    "scene_skill",
    "run_tool",
    "runner",
    "device_driver",
    "recorder",
    "report_gate"
  ],
  "nodes": [
    {
      "id": "scene_yaml",
      "lane": "project",
      "col": 0,
      "type": "database",
      "label": "Scene YAML",
      "sublabel": "app · actions · metrics",
      "width": 128,
      "tag": "项目资产"
    },
    {
      "id": "scene_skill",
      "lane": "project",
      "col": 1,
      "type": "frontend",
      "label": "Scene Skill",
      "sublabel": "一次调用即可回归",
      "width": 128,
      "tag": "SKILL.md"
    },
    {
      "id": "run_tool",
      "lane": "platform",
      "col": 2,
      "type": "backend",
      "label": "run_performance_test",
      "sublabel": "一键执行入口",
      "width": 148,
      "tag": "已完成"
    },
    {
      "id": "runner",
      "lane": "platform",
      "col": 3,
      "type": "messagebus",
      "label": "Runner",
      "sublabel": "状态机 · 重试 · 中位数",
      "width": 140,
      "tag": "已完成"
    },
    {
      "id": "device_driver",
      "lane": "platform",
      "col": 4,
      "type": "external",
      "label": "DeviceDriver",
      "sublabel": "mobilecli + devicectl",
      "width": 136
    },
    {
      "id": "recorder",
      "lane": "platform",
      "col": 5,
      "type": "external",
      "label": "Recorder",
      "sublabel": "xctrace + 自解析",
      "width": 136,
      "tag": "D13"
    },
    {
      "id": "runstore",
      "lane": "evidence",
      "col": 3,
      "type": "database",
      "label": "Run Store",
      "sublabel": "run.json + plan.json",
      "width": 128
    },
    {
      "id": "report_gate",
      "lane": "evidence",
      "col": 5,
      "type": "backend",
      "label": "Report + Gate",
      "sublabel": "status · gate · verdict",
      "width": 140,
      "tag": "pass / fail"
    }
  ],
  "edges": [
    {
      "id": "define-scene",
      "from": "scene_yaml",
      "to": "scene_skill",
      "label": "定义",
      "variant": "emphasis"
    },
    {
      "id": "invoke-run",
      "from": "scene_skill",
      "to": "run_tool",
      "label": "执行",
      "variant": "emphasis"
    },
    {
      "id": "start-take",
      "from": "run_tool",
      "to": "runner",
      "label": "开始 Take",
      "variant": "default"
    },
    {
      "id": "prepare-device",
      "from": "runner",
      "to": "device_driver",
      "label": "前台 · warmup",
      "variant": "emphasis"
    },
    {
      "id": "replay-actions",
      "from": "device_driver",
      "to": "recorder",
      "label": "回放 actions",
      "variant": "emphasis"
    },
    {
      "id": "analyze",
      "from": "recorder",
      "to": "report_gate",
      "label": "解析 trace",
      "variant": "emphasis"
    },
    {
      "id": "write-run",
      "from": "runner",
      "to": "runstore",
      "label": "写入证据",
      "variant": "dashed"
    },
    {
      "id": "store-report",
      "from": "runstore",
      "to": "report_gate",
      "label": "汇总",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "一次定义，次次上演",
      "items": [
        "Scene YAML 与 Scene Skill 属于项目，随项目一起演进",
        "平台只提供通用能力，不绑定任何业务场景",
        "重复测试就是再执行一次同一个 Skill"
      ]
    },
    {
      "dot": "rose",
      "title": "不伪造通过",
      "items": [
        "缺 trace、缺指标值即降级为 partial",
        "completed 必须能追溯到证据",
        "status 与 gate 分离，阈值随报告一起输出"
      ]
    },
    {
      "dot": "amber",
      "title": "跑在真机上",
      "items": [
        "mobilecli 驱动 UI，devicectl 解析安装与 pid",
        "xctrace 三 pass 录制，PerfStage 自己解析",
        "4 个指标一次 Take 约 3 分钟"
      ]
    }
  ],
  "groups": [
    {
      "id": "project_assets",
      "label": "项目自有资产",
      "lane": "project",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "platform_core",
      "label": "MCP + Runner",
      "lane": "platform",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "device_work",
      "label": "设备动作与录制",
      "lane": "platform",
      "fromCol": 4,
      "toCol": 5
    },
    {
      "id": "evidence_work",
      "label": "落盘、判定与复跑",
      "lane": "evidence",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    }
  ]
}
